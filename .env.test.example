# Test environment variables
# Copy this to .env.test and fill in your test credentials

# Environment
ENV=test
NODE_ENV=test
PLAYWRIGHT_TEST=1

# Supabase - Real project credentials for E2E testing
# Get from: Supabase Dashboard > Settings > API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OAuth (mock client IDs for testing)
PUBLIC_GOOGLE_CLIENT_ID=test-google-client-id
PUBLIC_FACEBOOK_CLIENT_ID=test-facebook-client-id
PUBLIC_AZURE_CLIENT_ID=test-azure-client-id

# OAuth Provider Toggles (set to 'true' or 'false')
PUBLIC_ENABLE_GOOGLE_OAUTH=true
PUBLIC_ENABLE_AZURE_OAUTH=true

# Contact
PUBLIC_ADMIN_EMAIL=admin@example.com

# App config
PUBLIC_APP_NAME=SaaS Boilerplate
PUBLIC_BASE_URL=http://localhost:4321

# Stripe (use Stripe test keys)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_stripe_webhook_secret
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key

# Stripe Price IDs are now configured in shared/config/stripe.ts

# Analytics (client-side)
PUBLIC_AMPLITUDE_API_KEY=test_amplitude_api_key_for_testing_only
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Baselime monitoring (client-side RUM)
PUBLIC_BASELIME_KEY=test_baselime_key_for_testing_only

# CORS
ALLOWED_ORIGIN=*

# Gemini AI (for testing)
GEMINI_API_KEY=test_gemini_api_key_for_testing_only

# Analytics (mock API key for testing)
AMPLITUDE_API_KEY=test_amplitude_api_key_for_testing_only

# Baselime (mock API key for testing)
BASELIME_API_KEY=test_baselime_api_key_for_testing_only

# Cloudflare Pages (for testing)
CF_PAGES_URL=

# Cron authentication (required for cron endpoint tests)
CRON_SECRET=test-cron-secret

# CMS encryption key for integration credentials (64 hex chars = 32 bytes)
CMS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Test authentication token
TEST_AUTH_TOKEN=test_auth_token_for_testing_only
