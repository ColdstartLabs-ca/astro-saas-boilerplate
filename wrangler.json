{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myimageupscaler",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "routes": [
    { "pattern": "myimageupscaler.com/*", "zone_name": "myimageupscaler.com" },
    { "pattern": "www.myimageupscaler.com/*", "zone_name": "myimageupscaler.com" }
  ],
  "assets": {
    "binding": "STATIC_ASSETS",
    "directory": "dist"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "myimageupscaler"
    }
  ]
}
