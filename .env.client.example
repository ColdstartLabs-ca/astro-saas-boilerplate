# Client environment variables (.env.client)
# These are PUBLIC_* vars exposed to the browser
# For LOCAL DEVELOPMENT only - production uses GitHub Actions vars
# Server-side secrets go in .env.api (see .env.api.example)

# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OAuth (public client IDs)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
PUBLIC_FACEBOOK_CLIENT_ID=your-facebook-client-id
PUBLIC_AZURE_CLIENT_ID=your-azure-client-id

# OAuth Provider Toggles (set to 'true' or 'false')
PUBLIC_ENABLE_GOOGLE_OAUTH=true
PUBLIC_ENABLE_AZURE_OAUTH=false

# Contact emails
PUBLIC_ADMIN_EMAIL=admin@example.com
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_PRIVACY_EMAIL=privacy@example.com
PUBLIC_LEGAL_EMAIL=legal@example.com
PUBLIC_SALES_EMAIL=sales@example.com
PUBLIC_TWITTER_HANDLE=example

# App config
PUBLIC_APP_NAME=SaaS Boilerplate
PUBLIC_BASE_URL=http://localhost:4321

# App branding and configuration
PUBLIC_APP_SLUG=saas-boilerplate
PUBLIC_DOWNLOAD_PREFIX=saas-boilerplate
PUBLIC_BATCH_FOLDER_NAME=saas-boilerplate_batch
PUBLIC_CACHE_USER_KEY_PREFIX=saas-boilerplate
PUBLIC_WEB_SERVICE_NAME=saas-boilerplate-web
PUBLIC_CRON_SERVICE_NAME=saas-boilerplate-cron

# GitHub
PUBLIC_GITHUB_USER=your-github-user
PUBLIC_GITHUB_REPO=saas-boilerplate

# Legal dates
PUBLIC_LAST_UPDATED_DATE=November 26, 2025

# Domains
PUBLIC_PRIMARY_DOMAIN=example.com
PUBLIC_APP_DOMAIN=example.com

# Stripe Configuration
# Centralized configuration is in shared/config/stripe.ts
# See: shared/config/stripe.ts for Price IDs and product definitions

# Get publishable key from: https://dashboard.stripe.com/test/apikeys
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Credit Pack Price IDs (renamed from NEXT_PUBLIC_* to PUBLIC_*)
PUBLIC_STRIPE_PRICE_CREDITS_SMALL=price_credits_small
PUBLIC_STRIPE_PRICE_CREDITS_MEDIUM=price_credits_medium
PUBLIC_STRIPE_PRICE_CREDITS_LARGE=price_credits_large

# Baselime monitoring (client-side RUM)
# Get key from: https://console.baselime.io/settings/api-keys
PUBLIC_BASELIME_KEY=

# Analytics
# Amplitude - Get from: https://app.amplitude.com > Settings > API Keys
PUBLIC_AMPLITUDE_API_KEY=
# Google Analytics 4 - Get from: https://analytics.google.com > Admin > Data Streams
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# CORS
ALLOWED_ORIGIN=*

# Cloudflare Pages (will be set automatically in production)
CF_PAGES_URL=
