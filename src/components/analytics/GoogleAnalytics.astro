---
/**
 * Google Analytics 4 Integration for Astro
 *
 * Loads the gtag.js script for Google Analytics tracking.
 * Only active when GA_MEASUREMENT_ID is set and not in development.
 */
import { clientEnv, isDevelopment } from '@shared/config/env';

const measurementId = clientEnv.GA_MEASUREMENT_ID;
const isEnabled = !isDevelopment() && measurementId;
---

{isEnabled && (
  <Fragment>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </Fragment>
)}
