---
/**
 * FAQ Component
 *
 * Reusable FAQ section for pSEO pages.
 * Note: JSON-LD schema is generated at the page level to avoid duplicates.
 * Used across pSEO pages for consistent FAQ rendering.
 */

import type { IFaqItem } from '@shared/types/pseo.types';

interface IProps {
  faqs: IFaqItem[];
  heading?: string;
}

const {
  faqs,
  heading = 'Frequently Asked Questions',
} = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h2 class="text-3xl font-bold text-white mb-8 text-center">
    {heading}
  </h2>
  <div class="space-y-4 max-w-3xl mx-auto">
    {faqs.map(faq => (
      <div class="bg-surface/30 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
        <p class="text-muted-foreground">{faq.answer}</p>
      </div>
    ))}
  </div>
</section>
