---
/**
 * CrossCategoryLinks Component
 *
 * Displays a "You Might Also Like" section at the bottom of pSEO pages,
 * linking to pages in OTHER categories to improve internal linking and
 * cross-category discoverability.
 */

type Category = 'comparison' | 'alternative' | 'use-case' | 'tool' | 'geo' | 'feature';

interface ICrossLink {
  href: string;
  label: string;
  description: string;
}

interface IProps {
  currentCategory: Category;
}

const { currentCategory } = Astro.props;

const linksByCategory: Record<Category, ICrossLink[]> = {
  comparison: [
    {
      href: '/alternative/outrank-alternative',
      label: 'Best Outrank Alternative (2026)',
      description: 'Looking for an alternative to Outrank? Compare features and pricing.',
    },
    {
      href: '/use-cases/saas-blog-automation',
      label: 'AI Blog Automation for SaaS',
      description: 'Scale your SaaS blog with AI-generated SEO content on autopilot.',
    },
    {
      href: '/tools/keyword-density-checker',
      label: 'Free Keyword Density Checker',
      description: 'Analyze keyword density in your content. Free, no signup required.',
    },
  ],
  alternative: [
    {
      href: '/compare/autopilotrank-vs-outrank',
      label: 'AutopilotRank vs Outrank: 2026 Comparison',
      description:
        'Detailed feature and pricing comparison between AutopilotRank and Outrank.',
    },
    {
      href: '/use-cases/saas-blog-automation',
      label: 'AI Blog Automation for SaaS',
      description: 'Scale your SaaS blog with automated SEO content.',
    },
    {
      href: '/tools/title-tag-optimizer',
      label: 'Free Title Tag Optimizer',
      description: 'Optimize your page titles for SEO. Free, instant results.',
    },
  ],
  'use-case': [
    {
      href: '/compare/autopilotrank-vs-outrank',
      label: 'AutopilotRank vs Outrank: 2026 Comparison',
      description:
        'See how AutopilotRank compares to the competition on features and price.',
    },
    {
      href: '/tools/keyword-density-checker',
      label: 'Free Keyword Density Checker',
      description: 'Check keyword density in your SEO content. Free tool, no signup.',
    },
    {
      href: '/geo/generative-engine-optimization',
      label: 'Generative Engine Optimization Guide',
      description: 'Master GEO to increase your visibility in ChatGPT and Google AI.',
    },
  ],
  tool: [
    {
      href: '/use-cases/saas-blog-automation',
      label: 'AI Blog Automation for SaaS',
      description: 'Scale your SaaS blog with AI-generated SEO content on autopilot.',
    },
    {
      href: '/geo/generative-engine-optimization',
      label: 'Generative Engine Optimization Guide',
      description: 'Master GEO to increase your visibility in AI-powered search.',
    },
    {
      href: '/compare/autopilotrank-vs-outrank',
      label: 'AutopilotRank vs Outrank: 2026 Comparison',
      description: 'Compare AutopilotRank vs Outrank on features, pricing, and AI quality.',
    },
  ],
  geo: [
    {
      href: '/tools/keyword-density-checker',
      label: 'Free Keyword Density Checker',
      description: 'Check keyword density for better SEO. Free, instant results.',
    },
    {
      href: '/compare/autopilotrank-vs-outrank',
      label: 'AutopilotRank vs Outrank: 2026 Comparison',
      description: 'Compare AutopilotRank vs Outrank on features, pricing, and AI quality.',
    },
  ],
  feature: [
    {
      href: '/compare/autopilotrank-vs-outrank',
      label: 'AutopilotRank vs Outrank: 2026 Comparison',
      description: 'See how AutopilotRank compares to Outrank on every feature and price point.',
    },
    {
      href: '/alternative/outrank-alternative',
      label: 'Best Outrank Alternative (2026)',
      description: 'Looking for an Outrank alternative? Compare AutopilotRank side-by-side.',
    },
    {
      href: '/use-cases/saas-blog-automation',
      label: 'AI Blog Automation for SaaS',
      description: 'Scale your SaaS blog with AI-generated SEO content on autopilot.',
    },
  ],
};

const links = linksByCategory[currentCategory];
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h2 class="text-2xl font-bold text-white mb-2 text-center">You Might Also Like</h2>
  <p class="text-muted-foreground text-center mb-8">
    Explore more resources from AutopilotRank
  </p>
  <div class="grid md:grid-cols-3 gap-4">
    {links.map(link => (
      <a
        href={link.href}
        class="group block bg-surface/30 hover:bg-surface/50 border border-border hover:border-accent/40 p-6 rounded-lg transition-all duration-200"
      >
        <h3 class="text-base font-semibold text-white group-hover:text-accent transition-colors mb-2">
          {link.label}
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {link.description}
        </p>
      </a>
    ))}
  </div>
</section>
