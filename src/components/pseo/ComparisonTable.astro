---
/**
 * ComparisonTable Component
 *
 * Renders a feature comparison table for alternative pages.
 * Displays AutopilotRank vs competitor features with checkmarks/crosses.
 */

import type { IFeatureRow } from '@shared/types/pseo.types';

interface IProps {
  features: IFeatureRow[];
  ourName?: string;
  theirName?: string;
}

const {
  features,
  ourName = 'AutopilotRank',
  theirName = 'Competitor',
} = Astro.props;

/**
 * Renders a boolean value as a checkmark or cross
 */
function renderBooleanValue(value: boolean): string {
  return value
    ? '<span class="text-green-400 text-xl">&#10003;</span>'
    : '<span class="text-red-400 text-xl">&#10007;</span>';
}

/**
 * Renders a cell value - handles both boolean and string values
 */
function renderCellValue(value: string | boolean): string {
  if (typeof value === 'boolean') {
    return renderBooleanValue(value);
  }
  return `<span class="text-white">${value}</span>`;
}
---

<div class="w-full overflow-x-auto">
  <table class="w-full border-collapse">
    <thead>
      <tr class="border-b border-border">
        <th class="text-left py-4 px-4 text-muted-foreground font-medium">Feature</th>
        <th class="text-center py-4 px-4 text-accent font-semibold">{ourName}</th>
        <th class="text-center py-4 px-4 text-muted-foreground font-medium">{theirName}</th>
      </tr>
    </thead>
    <tbody>
      {features.map((row, index) => (
        <tr class={`border-b border-border ${index % 2 === 0 ? 'bg-surface/30' : ''}`}>
          <td class="py-4 px-4 text-white font-medium">{row.feature}</td>
          <td class="py-4 px-4 text-center" set:html={renderCellValue(row.us)} />
          <td class="py-4 px-4 text-center" set:html={renderCellValue(row.them)} />
        </tr>
      ))}
    </tbody>
  </table>
</div>
