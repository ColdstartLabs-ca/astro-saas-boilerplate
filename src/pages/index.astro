---
import Layout from '../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import HomePageClient from '@client/components/pages/HomePageClient';

// SEO metadata
const title = `${clientEnv.APP_NAME} - AI SEO Content Generator | Multi-Model AI + Humanizer`;
const description = `Generate 100+ SEO-optimized articles/month automatically. Multi-model AI (GPT-4, Claude, Gemini), humanizer for undetectable content, native WordPress publishing, and GSC integration. 3 free articles to try, no credit card.`;
---

<Layout title={title}>
  <!-- SEO Meta Tags in head slot -->
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${clientEnv.BASE_URL}/`} />
    <meta property="og:site_name" content={clientEnv.APP_NAME} />
    <meta property="og:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": clientEnv.APP_NAME,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "49.00",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "billingDuration": "P1M"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "12"
      }
    })}></script>
  </Fragment>

  <!-- React island for interactive landing page -->
  <HomePageClient client:load />
</Layout>
