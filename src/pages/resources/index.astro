---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';

export const prerender = true;

const resources = [
  {
    title: 'Best AI SEO Tools 2026',
    description: 'Complete comparison of the top AI-powered SEO content tools. Find the right platform for your needs and budget.',
    href: '/resources/best-ai-seo-tools-2026',
    category: 'Comparison'
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SEO Resources',
  description: 'Helpful resources for SEO content creation and AI writing tools.',
  itemListElement: resources.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.title,
    url: `https://autopilotrank.com${r.href}`
  }))
};
---

<Layout>
  <SEO
    title="SEO Resources & Guides — AutopilotRank"
    description="Helpful resources for SEO content creation, AI writing tools, and content marketing strategies."
    canonicalPath="/resources"
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="min-h-screen bg-main">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          SEO Resources
        </h1>
        <p class="text-xl text-gray-300">
          Guides, comparisons, and resources to help you create better SEO content.
        </p>
      </header>

      <section class="grid gap-6">
        {resources.map((resource) => (
          <a
            href={resource.href}
            class="block p-6 bg-surface rounded-lg hover:bg-surface/80 transition-colors border border-gray-800"
          >
            <span class="text-xs text-accent font-medium uppercase tracking-wider">{resource.category}</span>
            <h2 class="text-xl font-bold text-white mt-2">{resource.title}</h2>
            <p class="text-gray-400 mt-2">{resource.description}</p>
            <span class="text-accent mt-4 inline-flex items-center gap-1">
              Read more <span>→</span>
            </span>
          </a>
        ))}
      </section>
    </div>
  </main>
</Layout>
