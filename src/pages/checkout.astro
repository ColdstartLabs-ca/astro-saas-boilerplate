---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Checkout">
  <main class="min-h-screen bg-main flex items-center justify-center px-6">
    <section class="max-w-xl text-center">
      <h1 class="text-4xl font-bold text-white mb-4">Checkout</h1>
      <p class="text-text-muted mb-8">
        Wire this page to your product-specific checkout flow or redirect users through the checkout API.
      </p>
      <a href="/pricing" class="inline-flex rounded-lg bg-accent px-5 py-3 font-semibold text-white">
        Back to pricing
      </a>
    </section>
  </main>
</Layout>
