---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import AdminDashboardLayout from '@client/components/admin/AdminDashboardLayout';
import AdminUserDetailPageClient from '@client/components/pages/AdminUserDetailPageClient';

const { userId } = Astro.params;
---

<DashboardLayout title="Admin - User Details">
  <AdminDashboardLayout client:load>
    <AdminUserDetailPageClient userId={userId} client:load />
  </AdminDashboardLayout>
</DashboardLayout>
