---
/**
 * Tool Page Dynamic Route
 *
 * Programmatic SEO free tool pages with interactive React components.
 * Prerendered at build time for zero runtime cost on Cloudflare Workers.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import { KeywordDensityTool } from '@client/components/tools/KeywordDensityTool';
import {
  getToolBySlug,
  getAllToolSlugs,
  getToolsBySlugs,
} from '@server/pseo/tools';
import { clientEnv } from '@shared/config/env';

export const prerender = true;

export function getStaticPaths() {
  const slugs = getAllToolSlugs();
  return slugs.map(slug => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const page = getToolBySlug(slug);

if (!page) {
  return Astro.redirect('/404');
}

// Get related tools for linking
const relatedTools = getToolsBySlugs(page.relatedTools);

// Build JSON-LD structured data - WebApplication schema
const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: page.toolName,
  description: page.toolDescription,
  url: `${clientEnv.BASE_URL}/tools/${page.slug}`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: clientEnv.APP_NAME,
    url: clientEnv.BASE_URL,
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: clientEnv.BASE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Tools',
      item: `${clientEnv.BASE_URL}/tools`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: page.toolName,
      item: `${clientEnv.BASE_URL}/tools/${page.slug}`,
    },
  ],
};

const pageUrl = `/tools/${page.slug}`;
---

<Layout title={page.metaTitle}>
  <Fragment slot="head">
    <SEO
      title={page.metaTitle}
      description={page.metaDescription}
      path={pageUrl}
      additionalMeta={[
        { name: 'keywords', content: [page.primaryKeyword, ...page.secondaryKeywords].join(', ') },
      ]}
    />
    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Breadcrumb Navigation -->
    <nav class="max-w-4xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><span class="mx-2">/</span></li>
        <li><a href="/tools" class="hover:text-accent transition-colors">Tools</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-white">{page.toolName}</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto px-4 py-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{page.h1}</h1>
      <p class="text-xl text-muted-foreground mb-6 max-w-2xl mx-auto">{page.toolDescription}</p>
      <span class="inline-block bg-accent/20 text-accent text-sm px-3 py-1 rounded-full">
        100% Free - No Signup Required
      </span>
    </section>

    <!-- Interactive Tool Section - Render based on componentName -->
    <section class="max-w-4xl mx-auto px-4 py-6">
      {page.componentName === 'KeywordDensityTool' ? (
        <KeywordDensityTool client:visible />
      ) : (
        <div class="bg-surface rounded-lg p-6 text-center text-muted-foreground">
          Tool coming soon...
        </div>
      )}
    </section>

    <!-- How to Use Section -->
    <section class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">
        How to Use This Tool
      </h2>
      <ol class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {page.howToUse.map((step, index) => (
          <li class="flex items-start space-x-4 bg-surface/30 p-4 rounded-lg">
            <span class="flex-shrink-0 w-8 h-8 bg-accent/20 text-accent rounded-full flex items-center justify-center font-bold text-sm">
              {index + 1}
            </span>
            <span class="text-white pt-1">{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Why Use This Tool Section -->
    <section class="max-w-4xl mx-auto px-4 py-12 bg-surface/20">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">
        Why Use This Tool?
      </h2>
      <ul class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {page.whyUseIt.map(reason => (
          <li class="flex items-start space-x-3 bg-main/50 p-4 rounded-lg">
            <span class="text-accent text-xl flex-shrink-0">&#10003;</span>
            <span class="text-white">{reason}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4 max-w-2xl mx-auto">
        {page.faqs.map(faq => (
          <div class="bg-surface/30 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
            <p class="text-muted-foreground">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-4xl mx-auto px-4 py-16 text-center">
      <div class="bg-gradient-to-r from-accent/20 to-accent/5 rounded-xl p-12 border border-accent/20">
        <h2 class="text-3xl font-bold text-white mb-4">
          Want AI to Handle Your SEO Content?
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          AutopilotRank generates human-quality, SEO-optimized content automatically. No manual keyword counting needed.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/pricing"
            class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
          >
            Start Free Trial
          </a>
          <a
            href="/features"
            class="inline-block bg-transparent border border-white/20 text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/5 transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- Related Tools Section -->
    {relatedTools.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">
          Related Free SEO Tools
        </h2>
        <div class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {relatedTools.map(tool => (
            <a
              href={`/tools/${tool.slug}`}
              class="block bg-surface/30 hover:bg-surface/50 p-6 rounded-lg transition-colors group"
            >
              <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">
                {tool.toolName}
              </h3>
              <p class="text-muted-foreground text-sm mt-2">
                {tool.metaDescription.slice(0, 100)}...
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Last Updated -->
    <div class="max-w-4xl mx-auto px-4 py-6 text-center text-sm text-muted-foreground">
      Last updated: {new Date(page.lastUpdated).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </div>
  </div>
</Layout>
