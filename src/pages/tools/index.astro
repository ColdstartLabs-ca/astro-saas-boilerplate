---
/**
 * Tools Index Page
 *
 * Lists all free SEO tools available on AutopilotRank.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getAllTools } from '@server/pseo/tools';
import { clientEnv } from '@shared/config/env';

export const prerender = true;

const tools = getAllTools();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: clientEnv.BASE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Free SEO Tools',
      item: `${clientEnv.BASE_URL}/tools`,
    },
  ],
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free SEO Tools',
  description: 'Collection of free SEO tools to help optimize your content for search engines.',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.toolName,
    url: `${clientEnv.BASE_URL}/tools/${tool.slug}`,
  })),
};
---

<Layout title="Free SEO Tools — AutopilotRank">
  <Fragment slot="head">
    <SEO
      title="Free SEO Tools — Analyze & Optimize Your Content"
      description="Free online SEO tools: keyword density checker, meta description validator, title tag optimizer. No signup required."
      path="/tools"
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Breadcrumb Navigation -->
    <nav class="max-w-5xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-white">Free SEO Tools</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Free SEO Tools
      </h1>
      <p class="text-xl text-muted-foreground mb-6 max-w-2xl mx-auto">
        Analyze and optimize your content with our collection of free SEO tools.
        No signup required - just instant results.
      </p>
      <span class="inline-block bg-accent/20 text-accent text-sm px-3 py-1 rounded-full">
        100% Free Forever
      </span>
    </section>

    <!-- Tools Grid -->
    <section class="max-w-5xl mx-auto px-4 py-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map(tool => (
          <a
            href={`/tools/${tool.slug}`}
            class="block bg-surface/30 hover:bg-surface/50 border border-border hover:border-accent/30 rounded-xl p-6 transition-all group"
          >
            <div class="w-12 h-12 bg-accent/20 rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent/30 transition-colors">
              <svg
                class="w-6 h-6 text-accent"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white mb-2 group-hover:text-accent transition-colors">
              {tool.toolName}
            </h2>
            <p class="text-muted-foreground text-sm mb-4">
              {tool.metaDescription.slice(0, 120)}...
            </p>
            <span class="text-accent text-sm font-medium group-hover:underline">
              Use Tool &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-5xl mx-auto px-4 py-16 text-center">
      <div class="bg-gradient-to-r from-accent/20 to-accent/5 rounded-xl p-12 border border-accent/20">
        <h2 class="text-3xl font-bold text-white mb-4">
          Automate Your SEO Content Creation
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          These tools are great for manual checks, but AutopilotRank can generate
          fully optimized SEO content automatically.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/pricing"
            class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
          >
            Start Free Trial
          </a>
          <a
            href="/features"
            class="inline-block bg-transparent border border-white/20 text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/5 transition-colors"
          >
            See All Features
          </a>
        </div>
      </div>
    </section>

    <!-- Additional Info Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-surface/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              class="w-8 h-8 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">100% Free</h3>
          <p class="text-muted-foreground text-sm">
            All tools are completely free to use. No hidden fees or premium versions.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-surface/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              class="w-8 h-8 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Instant Results</h3>
          <p class="text-muted-foreground text-sm">
            Get immediate feedback on your content. No waiting, no processing delays.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-surface/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              class="w-8 h-8 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">No Signup Required</h3>
          <p class="text-muted-foreground text-sm">
            Use all tools without creating an account. Your privacy matters to us.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
