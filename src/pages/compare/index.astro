---
/**
 * Compare Index Page
 *
 * Landing page listing all comparison pages.
 * Used for SEO and navigation purposes.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getAllComparisons } from '@server/pseo/comparisons';
import { clientEnv } from '@shared/config/env';

export const prerender = true;

const comparisons = getAllComparisons();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: clientEnv.BASE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Compare',
      item: `${clientEnv.BASE_URL}/compare`,
    },
  ],
};

const pageUrl = '/compare';
---

<Layout title="Compare AutopilotRank with Competitors - AI SEO Tool Comparisons">
  <Fragment slot="head">
    <SEO
      title="Compare AutopilotRank with Competitors - AI SEO Tool Comparisons"
      description="Compare AutopilotRank with other AI SEO tools. See feature comparisons, pricing breakdowns, and find the best AI content tool for your business."
      path={pageUrl}
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Breadcrumb Navigation -->
    <nav class="max-w-5xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-white">Compare</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Compare AutopilotRank with Competitors
      </h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">
        See how AutopilotRank stacks up against other AI SEO content tools. Make an informed decision with detailed feature and pricing comparisons.
      </p>
    </section>

    <!-- Comparisons Grid -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {comparisons.map(comp => (
          <a
            href={`/compare/${comp.slug}`}
            class="block bg-surface/30 hover:bg-surface/50 border border-border rounded-lg p-6 transition-colors group"
          >
            <h2 class="text-xl font-semibold text-white group-hover:text-accent transition-colors mb-3">
              {comp.competitorA} vs {comp.competitorB}
            </h2>
            <p class="text-muted-foreground text-sm mb-4">
              {comp.metaDescription.slice(0, 120)}...
            </p>
            <span class="text-accent text-sm font-medium group-hover:underline">
              Read comparison &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-5xl mx-auto px-4 py-16 text-center">
      <div class="bg-gradient-to-r from-accent/20 to-accent/5 rounded-xl p-12 border border-accent/20">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Try AutopilotRank?
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Start your free trial today and see why businesses choose AutopilotRank for AI SEO content.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/pricing"
            class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
          >
            Start Free Trial
          </a>
          <a
            href="/alternative"
            class="inline-block bg-transparent border border-white/20 text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/5 transition-colors"
          >
            View All Alternatives
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
