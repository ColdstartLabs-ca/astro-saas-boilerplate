---
/**
 * Comparison Page Dynamic Route
 *
 * Programmatic SEO comparison pages (AutopilotRank vs Competitor).
 * Prerendered at build time for zero runtime cost on Cloudflare Workers.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import ComparisonTable from '../../components/pseo/ComparisonTable.astro';
import FAQ from '../../components/pseo/FAQ.astro';
import CTASection from '../../components/pseo/CTASection.astro';
import {
  getComparisonBySlug,
  getAllComparisonSlugs,
  getComparisonsBySlugs,
} from '@server/pseo/comparisons';
import { clientEnv } from '@shared/config/env';

export const prerender = true;

export function getStaticPaths() {
  const slugs = getAllComparisonSlugs();
  return slugs.map(slug => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const page = getComparisonBySlug(slug);

if (!page) {
  return Astro.redirect('/404');
}

// Get related comparisons for linking
const relatedComparisons = getComparisonsBySlugs(page.relatedComparisons);

// Build JSON-LD structured data
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: clientEnv.APP_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '9',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '250',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: clientEnv.BASE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Compare',
      item: `${clientEnv.BASE_URL}/compare`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${page.competitorA} vs ${page.competitorB}`,
      item: `${clientEnv.BASE_URL}/compare/${page.slug}`,
    },
  ],
};

const pageUrl = `/compare/${page.slug}`;
---

<Layout title={page.metaTitle}>
  <Fragment slot="head">
    <SEO
      title={page.metaTitle}
      description={page.metaDescription}
      path={pageUrl}
      additionalMeta={[
        { name: 'keywords', content: [page.primaryKeyword, ...page.secondaryKeywords].join(', ') },
      ]}
    />
    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Breadcrumb Navigation -->
    <nav class="max-w-5xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><span class="mx-2">/</span></li>
        <li><a href="/compare" class="hover:text-accent transition-colors">Compare</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-white">{page.competitorA} vs {page.competitorB}</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{page.h1}</h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">{page.verdict}</p>
      <a
        href="/pricing"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
      >
        Start Free Trial
      </a>
    </section>

    <!-- Feature Comparison Table -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">
        Feature Comparison: {page.competitorA} vs {page.competitorB}
      </h2>
      <div class="bg-surface/50 rounded-lg p-6">
        <ComparisonTable
          features={page.featureComparison}
          ourName={page.competitorA}
          theirName={page.competitorB}
        />
      </div>
    </section>

    <!-- Pros & Cons Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">
        Pros & Cons
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <!-- AutopilotRank Pros & Cons -->
        <div>
          <h3 class="text-2xl font-semibold text-accent mb-4 text-center">{page.competitorA}</h3>
          <div class="space-y-4">
            <div>
              <h4 class="text-lg font-medium text-green-400 mb-2">Pros</h4>
              <ul class="space-y-2">
                {page.prosConsUs.pros.map(pro => (
                  <li class="flex items-start space-x-3 bg-green-500/10 border border-green-500/20 p-3 rounded-lg">
                    <span class="text-green-400 text-lg">&#10003;</span>
                    <span class="text-white">{pro}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h4 class="text-lg font-medium text-red-400 mb-2">Cons</h4>
              <ul class="space-y-2">
                {page.prosConsUs.cons.map(con => (
                  <li class="flex items-start space-x-3 bg-red-500/10 border border-red-500/20 p-3 rounded-lg">
                    <span class="text-red-400 text-lg">&#10007;</span>
                    <span class="text-white">{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Competitor Pros & Cons -->
        <div>
          <h3 class="text-2xl font-semibold text-muted-foreground mb-4 text-center">{page.competitorB}</h3>
          <div class="space-y-4">
            <div>
              <h4 class="text-lg font-medium text-green-400 mb-2">Pros</h4>
              <ul class="space-y-2">
                {page.prosConsThem.pros.map(pro => (
                  <li class="flex items-start space-x-3 bg-green-500/10 border border-green-500/20 p-3 rounded-lg">
                    <span class="text-green-400 text-lg">&#10003;</span>
                    <span class="text-white">{pro}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h4 class="text-lg font-medium text-red-400 mb-2">Cons</h4>
              <ul class="space-y-2">
                {page.prosConsThem.cons.map(con => (
                  <li class="flex items-start space-x-3 bg-red-500/10 border border-red-500/20 p-3 rounded-lg">
                    <span class="text-red-400 text-lg">&#10007;</span>
                    <span class="text-white">{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Comparison Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">
        Pricing Comparison
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <!-- AutopilotRank Pricing -->
        <div class="bg-accent/10 border border-accent/20 rounded-lg p-6">
          <h3 class="text-xl font-semibold text-accent mb-4 text-center">{page.competitorA}</h3>
          <table class="w-full">
            <thead>
              <tr class="border-b border-accent/20">
                <th class="text-left py-2 text-muted-foreground">Plan</th>
                <th class="text-left py-2 text-muted-foreground">Price</th>
                <th class="text-left py-2 text-muted-foreground">Credits</th>
              </tr>
            </thead>
            <tbody>
              {page.pricingComparison.us.map(tier => (
                <tr class="border-b border-accent/10">
                  <td class="py-3 text-white font-medium">{tier.plan}</td>
                  <td class="py-3 text-accent font-semibold">{tier.price}</td>
                  <td class="py-3 text-muted-foreground">{tier.credits}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Competitor Pricing -->
        <div class="bg-surface/30 border border-border rounded-lg p-6">
          <h3 class="text-xl font-semibold text-muted-foreground mb-4 text-center">{page.competitorB}</h3>
          <table class="w-full">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-2 text-muted-foreground">Plan</th>
                <th class="text-left py-2 text-muted-foreground">Price</th>
                <th class="text-left py-2 text-muted-foreground">Credits</th>
              </tr>
            </thead>
            <tbody>
              {page.pricingComparison.them.map(tier => (
                <tr class="border-b border-border">
                  <td class="py-3 text-white font-medium">{tier.plan}</td>
                  <td class="py-3 text-white font-semibold">{tier.price}</td>
                  <td class="py-3 text-muted-foreground">{tier.credits}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Final Verdict Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <div class="bg-surface/50 rounded-lg p-8 border border-border">
        <h2 class="text-3xl font-bold text-white mb-6 text-center">
          Our Verdict
        </h2>
        <p class="text-lg text-muted-foreground text-center max-w-3xl mx-auto">
          {page.verdict}
        </p>
        <div class="text-center mt-6">
          <a
            href={page.competitorBUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-accent transition-colors text-sm underline"
          >
            Visit {page.competitorB} website
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQ faqs={page.faqs} />

    <!-- CTA Section -->
    <CTASection
      heading={`Ready to Try a Better ${page.competitorB} Alternative?`}
    />

    <!-- Related Comparisons Section -->
    {relatedComparisons.length > 0 && (
      <section class="max-w-5xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">
          Other Comparisons You Might Like
        </h2>
        <div class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {relatedComparisons.map(comp => (
            <a
              href={`/compare/${comp.slug}`}
              class="block bg-surface/30 hover:bg-surface/50 p-6 rounded-lg transition-colors group"
            >
              <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">
                {comp.title}
              </h3>
              <p class="text-muted-foreground text-sm mt-2">{comp.metaDescription.slice(0, 100)}...</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Last Updated -->
    <div class="max-w-5xl mx-auto px-4 py-6 text-center text-sm text-muted-foreground">
      Last updated: {new Date(page.lastUpdated).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </div>
  </div>
</Layout>
