---
import Layout from '../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import PricingPageClient from '@client/components/pages/PricingPageClient';

// SEO metadata
const title = 'Simple, Transparent Pricing';
const description = `Choose the subscription plan that fits your needs. Get monthly credits with automatic rollover. Free tier available, paid plans from $9 to $149 per month.`;---

<Layout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} - ${clientEnv.APP_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${clientEnv.BASE_URL}/pricing`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${clientEnv.BASE_URL}/og-image-pricing.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${clientEnv.BASE_URL}/og-image-pricing.png`} />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/pricing`} />
  </Fragment>

  <PricingPageClient client:load />
</Layout>
