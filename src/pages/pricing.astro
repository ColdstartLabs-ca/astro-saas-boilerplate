---
import Layout from '../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import { SUBSCRIPTION_CONFIG } from '@shared/config/subscription.config';

// SEO metadata
const title = 'Simple, Transparent Pricing';
const description = `Choose the subscription plan that fits your needs. Get monthly credits with automatic rollover. Free tier available, paid plans from $49 to $249 per month.`
const plans = SUBSCRIPTION_CONFIG.plans.filter(plan => plan.enabled || plan.key === 'free');
---

<Layout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} - ${clientEnv.APP_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${clientEnv.BASE_URL}/pricing`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clientEnv.APP_NAME} />
    <meta property="og:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} - ${clientEnv.APP_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/pricing`} />
  </Fragment>

  <main class="min-h-screen bg-main">
    <section class="max-w-6xl mx-auto px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent mb-3">Pricing</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{title}</h1>
      <p class="text-lg text-text-muted max-w-3xl mb-12">{description}</p>

      <div class="grid md:grid-cols-3 gap-6">
        {plans.map(plan => (
          <article class={`rounded-lg border p-6 bg-surface ${plan.recommended ? 'border-accent' : 'border-border'}`}>
            {plan.recommended && (
              <p class="text-xs font-semibold uppercase tracking-wider text-accent mb-3">Recommended</p>
            )}
            <h2 class="text-2xl font-bold text-white mb-2">{plan.name}</h2>
            <p class="text-text-muted mb-5">{plan.description}</p>
            <p class="text-4xl font-bold text-white mb-6">
              ${(plan.priceInCents / 100).toFixed(0)}
              <span class="text-sm font-medium text-text-muted">/{plan.interval}</span>
            </p>
            <ul class="space-y-3 mb-8">
              {plan.features.map(feature => (
                <li class="text-sm text-text-muted">{feature}</li>
              ))}
            </ul>
            <a
              href="/checkout"
              class="inline-flex w-full items-center justify-center rounded-lg bg-accent px-4 py-3 font-semibold text-white hover:bg-accent/90 transition-colors"
            >
              Get started
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
