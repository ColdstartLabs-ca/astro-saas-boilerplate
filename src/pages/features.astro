---
import Layout from '../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import FeaturesPageClient from '@client/components/pages/FeaturesPageClient';

// SEO metadata
const title = 'Features';
const description = `Discover the powerful features of ${clientEnv.APP_NAME}. Built for developers, by developers.`
---

<Layout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} - ${clientEnv.APP_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${clientEnv.BASE_URL}/features`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/features`} />
  </Fragment>

  <FeaturesPageClient client:load />
</Layout>
