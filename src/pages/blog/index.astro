---
import Layout from '../../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import { getAllPosts } from '@server/blog';
import { BlogGrid } from '@client/components/blog/BlogGrid';
import { BlogEmptyState } from '@client/components/blog/BlogEmptyState';

const allPosts = getAllPosts();
const [featuredPost, ...otherPosts] = allPosts;

// SEO metadata
const title = `Blog - SEO Content Strategy & AI Writing Guides`;
const description = `Learn about AI-powered SEO content creation, keyword strategies, and scaling your content marketing. Expert guides from ${clientEnv.APP_NAME}.`;
---

<Layout title={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${clientEnv.APP_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${clientEnv.BASE_URL}/blog`} />
    <meta property="og:site_name" content={clientEnv.APP_NAME} />
    <meta property="og:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${clientEnv.APP_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${clientEnv.BASE_URL}/og-image.png`} />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/blog`} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Hero Section -->
    <section class="relative py-16 md:py-24 overflow-hidden">
      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 text-accent text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          Tips, Tutorials & Guides
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight">
          SEO Content
          <span class="block bg-gradient-to-r from-accent via-secondary to-tertiary bg-clip-text text-transparent">
            Strategy & Insights
          </span>
        </h1>
        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
          Master AI-powered content creation, keyword strategy, and scaling your SEO
          with our in-depth guides and expert analysis.
        </p>
      </div>
    </section>

    <!-- Featured Post -->
    {featuredPost && (
      <section class="py-16">
        <div class="container mx-auto px-4 max-w-6xl">
          <a href={`/blog/${featuredPost.slug}`} class="group block">
            <article class="relative bg-gradient-to-br from-surface via-surface to-surface-light rounded-3xl border border-border overflow-hidden hover:border-accent/50 transition-all duration-500 hover:shadow-card-hover">
              <div class="grid md:grid-cols-2 gap-0">
                <!-- Cover Image -->
                <div class="aspect-[16/10] md:aspect-auto relative overflow-hidden">
                  {featuredPost.image ? (
                    <img
                      src={featuredPost.image}
                      alt={featuredPost.title}
                      class="object-cover group-hover:scale-105 transition-transform duration-700 w-full h-full"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-accent/20 via-secondary/10 to-tertiary/20 flex items-center justify-center">
                      <svg class="w-12 h-12 text-accent/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent to-surface/10" />
                  <div class="absolute top-4 left-4 z-10">
                    <span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-accent text-white shadow-lg">
                      Featured
                    </span>
                  </div>
                </div>
                <!-- Content -->
                <div class="p-8 md:p-10 lg:p-12 flex flex-col justify-center">
                  <div class="flex items-center gap-3 mb-5">
                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20">
                      {featuredPost.category}
                    </span>
                    <span class="text-sm text-muted-foreground flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {featuredPost.readingTime}
                    </span>
                  </div>
                  <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4 group-hover:text-accent transition-colors leading-tight">
                    {featuredPost.title}
                  </h2>
                  <p class="text-text-secondary mb-6 line-clamp-3 text-base md:text-lg leading-relaxed">
                    {featuredPost.description}
                  </p>
                  <div class="flex items-center justify-between mt-auto">
                    <span class="text-sm text-text-secondary flex items-center gap-1.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {new Date(featuredPost.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </span>
                    <span class="inline-flex items-center gap-2 text-accent font-semibold group-hover:gap-3 transition-all whitespace-nowrap">
                      Read Article
                      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </article>
          </a>
        </div>
      </section>
    )}

    <!-- Blog Posts Grid with Search, Filters & Pagination -->
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-6xl">
        {otherPosts.length > 0 ? (
          <BlogGrid client:load posts={otherPosts} />
        ) : !featuredPost ? (
          <BlogEmptyState client:load />
        ) : null}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-accent via-secondary to-accent" />
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.1),transparent_50%)]" />
      <div class="container mx-auto px-4 max-w-4xl text-center relative z-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
          Ready to Scale Your Content?
        </h2>
        <p class="text-white/80 mb-8 text-lg max-w-xl mx-auto">
          Start creating AI-powered SEO content that ranks. Try {clientEnv.APP_NAME} free today.
        </p>
        <a
          href="/?signup=1"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-accent font-semibold rounded-xl hover:bg-white/90 hover:shadow-lg transition-all duration-300"
        >
          Get Started Free
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>
