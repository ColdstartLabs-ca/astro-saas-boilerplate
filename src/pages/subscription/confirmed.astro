---
import Layout from '../../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';

// SEO metadata
const title = 'Subscription Confirmed';
const description = 'Your subscription has been successfully confirmed. Thank you for joining!';
---

<Layout title={title}>
  <Fragment slot="head">
    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/subscription/confirmed`} />
  </Fragment>

  <main class="min-h-screen bg-main flex items-center justify-center px-6">
    <section class="max-w-xl text-center">
      <h1 class="text-4xl font-bold text-white mb-4">{title}</h1>
      <p class="text-text-muted mb-8">{description}</p>
      <a href="/dashboard" class="inline-flex rounded-lg bg-accent px-5 py-3 font-semibold text-white">
        Go to dashboard
      </a>
    </section>
  </main>
</Layout>
