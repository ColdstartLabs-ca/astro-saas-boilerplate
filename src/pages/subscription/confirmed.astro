---
import Layout from '../../layouts/Layout.astro';
import { clientEnv } from '@shared/config/env';
import SubscriptionConfirmedClient from '@client/components/pages/SubscriptionConfirmedClient';

// SEO metadata
const title = 'Subscription Confirmed';
const description = 'Your subscription has been successfully confirmed. Thank you for joining!';
---

<Layout title={title}>
  <Fragment slot="head">
    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`${clientEnv.BASE_URL}/subscription/confirmed`} />
  </Fragment>

  <!-- Subscription confirmed client component -->
  <SubscriptionConfirmedClient client:load />
</Layout>
