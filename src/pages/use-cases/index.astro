---
/**
 * Use Cases Index Page
 *
 * Lists all use case pages grouped by industry for programmatic SEO.
 * Prerendered at build time.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import { getUseCasesByIndustry, getAllUseCases } from '@server/pseo/use-cases';

export const prerender = true;

const useCasesByIndustry = getUseCasesByIndustry();
const allUseCases = getAllUseCases();
const industries = Object.keys(useCasesByIndustry).sort();
---

<Layout title="AI SEO Content Use Cases - AutopilotRank">
  <Fragment slot="head">
    <SEO
      title="AI SEO Content Use Cases - AutopilotRank"
      description="Discover how different industries use AutopilotRank for AI-powered SEO content automation. From e-commerce to SaaS, find your use case."
      path="/use-cases"
    />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        AI SEO Content Use Cases
      </h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">
        Discover how businesses in different industries use AutopilotRank to automate
        their SEO content creation and drive organic growth.
      </p>
    </section>

    <!-- Use Cases by Industry -->
    {industries.map(industry => (
      <section class="max-w-5xl mx-auto px-4 py-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="bg-accent/20 text-accent px-3 py-1 rounded-full text-sm font-medium">
            {industry}
          </span>
          <span class="text-muted-foreground text-sm">
            {useCasesByIndustry[industry].length} {useCasesByIndustry[industry].length === 1 ? 'use case' : 'use cases'}
          </span>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {useCasesByIndustry[industry].map(uc => (
            <a
              href={`/use-cases/${uc.slug}`}
              class="block bg-surface/30 hover:bg-surface/50 p-6 rounded-lg transition-colors group border border-border hover:border-accent/50"
            >
              <h2 class="text-xl font-semibold text-white group-hover:text-accent transition-colors mb-2">
                {uc.title}
              </h2>
              <p class="text-muted-foreground text-sm">
                {uc.metaDescription.slice(0, 120)}...
              </p>
              <span class="inline-block mt-4 text-accent text-sm font-medium">
                Learn More &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- All Use Cases Grid (Alternative View) -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">
        All Use Cases
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allUseCases.map(uc => (
          <a
            href={`/use-cases/${uc.slug}`}
            class="block bg-surface/30 hover:bg-surface/50 p-6 rounded-lg transition-colors group border border-border hover:border-accent/50"
          >
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs bg-accent/20 text-accent px-2 py-0.5 rounded-full">
                {uc.industry}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors mb-2">
              {uc.title}
            </h3>
            <p class="text-muted-foreground text-sm">
              {uc.metaDescription.slice(0, 100)}...
            </p>
            <span class="inline-block mt-4 text-accent text-sm font-medium">
              Learn More &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-5xl mx-auto px-4 py-16 text-center">
      <div class="bg-gradient-to-r from-accent/20 to-accent/5 rounded-xl p-12 border border-accent/20">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Automate Your Content?
        </h2>
        <p class="text-xl text-muted-foreground mb-8">
          Start your free trial and see the difference.
        </p>
        <a
          href="/pricing"
          class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
        >
          Start Free Trial
        </a>
      </div>
    </section>
  </div>
</Layout>
