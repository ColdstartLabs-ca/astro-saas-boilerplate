---
/**
 * Feature Page Dynamic Route
 *
 * Programmatic SEO feature landing pages.
 * Prerendered at build time for zero runtime cost on Cloudflare Workers.
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import CrossCategoryLinks from '../../components/pseo/CrossCategoryLinks.astro';
import {
  getFeatureBySlug,
  getAllFeatureSlugs,
  getFeaturesBySlugs,
} from '@server/pseo/features';
import { clientEnv } from '@shared/config/env';

export const prerender = true;

export function getStaticPaths() {
  const slugs = getAllFeatureSlugs();
  return slugs.map(slug => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const page = getFeatureBySlug(slug);

if (!page) {
  return Astro.redirect('/404');
}

// Get related features for linking
const relatedFeatures = getFeaturesBySlugs(page.relatedFeatures);

// Build JSON-LD structured data
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: clientEnv.APP_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '49',
    priceCurrency: 'USD',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '250',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: clientEnv.BASE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Features',
      item: `${clientEnv.BASE_URL}/features`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: page.featureName,
      item: `${clientEnv.BASE_URL}/features/${page.slug}`,
    },
  ],
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.h1,
  step: page.howItWorks.map(s => ({
    '@type': 'HowToStep',
    position: s.step,
    name: s.title,
    text: s.description,
  })),
};

const pageUrl = `/features/${page.slug}`;

/**
 * Renders a boolean value as a checkmark or cross HTML string
 */
function renderCellValue(value: boolean | string): string {
  if (typeof value === 'boolean') {
    return value
      ? '<span class="text-green-400 text-xl">&#10003;</span>'
      : '<span class="text-red-400 text-xl">&#10007;</span>';
  }
  return `<span class="text-white">${value}</span>`;
}
---

<Layout title={page.metaTitle}>
  <Fragment slot="head">
    <SEO
      title={page.metaTitle}
      description={page.metaDescription}
      path={pageUrl}
      additionalMeta={[
        { name: 'keywords', content: [page.primaryKeyword, ...page.secondaryKeywords].join(', ') },
      ]}
    />
    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  </Fragment>

  <div class="min-h-screen bg-main">
    <!-- Breadcrumb Navigation -->
    <nav class="max-w-5xl mx-auto px-4 py-4">
      <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
        <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
        <li><span class="mx-2">/</span></li>
        <li><a href="/features" class="hover:text-accent transition-colors">Features</a></li>
        <li><span class="mx-2">/</span></li>
        <li class="text-white">{page.featureName}</li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{page.h1}</h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">{page.heroSubtitle}</p>
      <a
        href="/pricing"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
      >
        Start Free Trial
      </a>
    </section>

    <!-- How It Works Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">How It Works</h2>
      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {page.howItWorks.map(step => (
          <div class="bg-surface/30 rounded-lg p-6 flex items-start space-x-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent/20 border border-accent/40 flex items-center justify-center text-accent font-bold text-sm">
              {step.step}
            </span>
            <div>
              <h3 class="text-white font-semibold mb-1">{step.title}</h3>
              <p class="text-muted-foreground text-sm">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Key Benefits Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">Key Benefits</h2>
      <div class="grid md:grid-cols-2 gap-4 max-w-3xl mx-auto">
        {page.benefits.map(benefit => (
          <div class="bg-accent/10 border border-accent/20 p-6 rounded-lg">
            <h3 class="text-white font-semibold mb-2">{benefit.title}</h3>
            <p class="text-muted-foreground text-sm">{benefit.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Plan Availability Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">Plan Availability</h2>
      <div class="grid md:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {page.planAvailability.map(plan => (
          <div
            class={`rounded-lg p-6 text-center border ${
              plan.included
                ? 'bg-accent/10 border-accent/30'
                : 'bg-surface/20 border-border'
            }`}
          >
            <div class="capitalize font-semibold text-white mb-2">{plan.plan}</div>
            <div class="mb-2">
              {plan.included
                ? <span class="text-green-400 text-2xl">&#10003;</span>
                : <span class="text-red-400 text-2xl">&#10007;</span>
              }
            </div>
            {plan.note && (
              <p class="text-muted-foreground text-sm">{plan.note}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Feature Comparison Table -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">
        {page.featureName}: AutopilotRank vs Competitors
      </h2>
      <div class="bg-surface/50 rounded-lg p-6 overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left py-4 px-4 text-muted-foreground font-medium">Feature</th>
              <th class="text-center py-4 px-4 text-accent font-semibold">AutopilotRank</th>
              <th class="text-center py-4 px-4 text-muted-foreground font-medium">Outrank</th>
              <th class="text-center py-4 px-4 text-muted-foreground font-medium">RankYak</th>
            </tr>
          </thead>
          <tbody>
            {page.featureComparison.map((row, index) => (
              <tr class={`border-b border-border ${index % 2 === 0 ? 'bg-surface/30' : ''}`}>
                <td class="py-4 px-4 text-white font-medium">{row.feature}</td>
                <td class="py-4 px-4 text-center" set:html={renderCellValue(row.us)} />
                <td class="py-4 px-4 text-center" set:html={renderCellValue(row.outrank)} />
                <td class="py-4 px-4 text-center" set:html={renderCellValue(row.rankyak)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4 max-w-3xl mx-auto">
        {page.faqs.map(faq => (
          <div class="bg-surface/30 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-white mb-2">{faq.question}</h3>
            <p class="text-muted-foreground">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="max-w-5xl mx-auto px-4 py-16 text-center">
      <div class="bg-gradient-to-r from-accent/20 to-accent/5 rounded-xl p-12 border border-accent/20">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Use {page.featureName}?
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Join thousands of businesses using AutopilotRank to automate their SEO content.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/pricing"
            class="inline-block bg-accent text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
          >
            Start Free Trial
          </a>
          <a
            href="/"
            class="inline-block bg-transparent border border-white/20 text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/5 transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- Related Features Section -->
    {relatedFeatures.length > 0 && (
      <section class="max-w-5xl mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold text-white mb-6 text-center">
          Related Features
        </h2>
        <div class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {relatedFeatures.map(feature => (
            <a
              href={`/features/${feature.slug}`}
              class="block bg-surface/30 hover:bg-surface/50 p-6 rounded-lg transition-colors group"
            >
              <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors">
                {feature.title}
              </h3>
              <p class="text-muted-foreground text-sm mt-2">{feature.metaDescription.slice(0, 100)}...</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Cross-Category Internal Links -->
    <CrossCategoryLinks currentCategory="feature" />

    <!-- Last Updated -->
    <div class="max-w-5xl mx-auto px-4 py-6 text-center text-sm text-muted-foreground">
      Last updated: {new Date(page.lastUpdated).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </div>
  </div>
</Layout>
