---
import { AdminDashboardLayout } from '@client/components/admin/AdminDashboardLayout';
import GlobalUI from '@client/components/GlobalUI';
import { ClientRouter } from 'astro:transitions';
import '@client/styles/index.css';

// Auth + admin role checks are handled by middleware (src/middleware.ts)

interface IProps {
  title?: string;
}

const { title = 'Admin Dashboard' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="antialiased">
    <AdminDashboardLayout client:only="react">
      <slot />
    </AdminDashboardLayout>
    <GlobalUI client:only="react" />
  </body>
</html>
