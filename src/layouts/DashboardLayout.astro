---
import DashboardLayout from '@client/components/dashboard/DashboardLayout';
import GlobalUI from '@client/components/GlobalUI';
import '@client/styles/index.css';

// Auth is handled by middleware (src/middleware.ts) for all /dashboard/* routes

interface IProps {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <DashboardLayout client:load>
      <slot />
    </DashboardLayout>
    <GlobalUI client:only="react" />
  </body>
</html>
