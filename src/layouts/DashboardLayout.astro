---
import DashboardLayout from '@client/components/dashboard/DashboardLayout';
import GlobalUI from '@client/components/GlobalUI';
import { LocaleInit } from '@client/components/i18n/LocaleInit';
import '@client/styles/index.css';
import { type Locale } from '../../i18n/config';

// Auth is handled by middleware (src/middleware.ts) for all /dashboard/* routes

// Get current locale — prefer locals.locale (set by middleware rewrite for non-default locales)
const currentLocale = (Astro.locals as { locale?: string }).locale || Astro.currentLocale || 'en';

interface IProps {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap"
    />
  </head>
  <body class="font-sans antialiased">
    <!-- Initialize client-side locale store -->
    <LocaleInit locale={currentLocale as Locale} client:load />
    <DashboardLayout client:only="react" />
    <GlobalUI client:only="react" />
  </body>
</html>
