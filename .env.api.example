# 🔒 NEVER COMMIT THIS FILE - Server-side secrets only!
# These variables have NO prefix and are NEVER exposed to the browser
# For LOCAL DEVELOPMENT only - production uses Cloudflare env vars
# Copy this to .env.api and fill in your actual secrets

# Environment mode (use 'development' for local dev)
ENV=development

# Supabase
# Get from: Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=XXX

# Stripe
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Baselime monitoring (server-side)
# Get from: https://console.baselime.io/settings/api-keys
BASELIME_API_KEY=XXX

# Analytics (server-side HTTP API)
# Amplitude - Get from: https://app.amplitude.com > Settings > API Keys
AMPLITUDE_API_KEY=XXX

# CORS (set to production domain)
ALLOWED_ORIGIN=https://example.com

# Cloudflare Deployment
# Get API token from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id-here
DOMAIN_NAME=example.com
WORKER_NAME=saas-boilerplate

# Cron Job Authentication
# Generate a secure random string for production (e.g., openssl rand -hex 32)
CRON_SECRET=your-secure-random-string-change-in-production

# Test Authentication (for E2E tests)
TEST_AUTH_TOKEN=your-test-auth-token-here

# ==========================================
# EMAIL PROVIDERS
# ==========================================
# Brevo (Primary) - 9,000 free emails/month
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key

# Resend (Fallback) - 3,000 free emails/month
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Common email settings
EMAIL_FROM_ADDRESS=noreply@example.com

# ==========================================
# AI PROVIDERS
# ==========================================
# OpenRouter for text generation (article content + VL model)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_VL_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_TEXT_MODEL=openai/gpt-4o
OPENROUTER_DEFAULT_MODEL=google/gemini-flash-3-preview

# Available writer presets — format: key(model-id) or just key for default model
AVAILABLE_WRITER_PRESETS=budget(google/gemini-2.5-flash-lite),balanced(google/gemini-3-flash-preview),pro(google/gemini-3-pro-preview),ultra(anthropic/claude-sonnet-4-5)

# Replicate for image generation
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=r8_xxx

# Available image presets — format: key(model-id) or just key for default model
AVAILABLE_IMAGE_PRESETS=budget(prunaai/z-image-turbo),balanced(black-forest-labs/flux-2-dev),pro(black-forest-labs/flux-2-pro),ultra(black-forest-labs/flux-2-max)

# OpenAI for embeddings
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxx

# ==========================================
# CMS INTEGRATIONS
# ==========================================
# CMS encryption key for encrypting WordPress/webhook credentials
# Generate with: openssl rand -base64 32 (minimum 32 characters)
CMS_ENCRYPTION_KEY=change-this-to-a-secure-random-string

# ==========================================
# GOOGLE OAUTH (GSC + Google API integrations)
# ==========================================
# Get from: Google Cloud Console > APIs & Credentials > OAuth 2.0 Client IDs
# Leave empty to disable Google API integrations (app still works without it)
GOOGLE_OAUTH_CLIENT_SECRET=

# GSC OAuth state signing secret (HMAC-signs the state param in the GSC connect flow to prevent CSRF)
# Falls back to CRON_SECRET if not set. Generate with: openssl rand -hex 32
GSC_STATE_SECRET=

# ==========================================
# INBOUND WEBHOOKS
# ==========================================
# Shared secret for verifying inbound webhook signatures (X-Signature-256 header)
# Generate with: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=
